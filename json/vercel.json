{
    "version": 2,
    "framework": null,
    "functions": {
        "public/index.php": {
            "runtime": "vercel-php@0.6.0"
        },
        "app/**/*.php": {
            "runtime": "vercel-php@0.6.0"
        },
        "login.php": {
            "runtime": "vercel-php@0.6.0"
        }
    },
    "routes": [
        {
            "src": "/public/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/public/json/(.*)",
            "dest": "/public/json/$1"
        },
        {
            "src": "/(.*\\.php)",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}